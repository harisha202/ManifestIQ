# =============================================================================
# ManifestIQ Backend Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env and insert your actual API keys and secrets.
# NEVER commit your actual .env file to version control.
# =============================================================================

# Google Gemini AI API Key (Required for RAG embeddings and LLM generation)
# Get yours at: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Database URL (Default uses local SQLite database; change to postgresql:// for production)
DATABASE_URL=sqlite:///./manifestiq.db

# JWT Secret Key (Generate a random secure 32-character hex string in production)
SECRET_KEY=your_super_secret_jwt_key_here

# Optional: Sentry DSN for error monitoring
SENTRY_DSN=
